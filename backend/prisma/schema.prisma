generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Perfil do participante na comunidade escolar
enum Role {
  ESTUDANTE
  PROFESSOR
  FUNCIONARIO
  COMUNIDADE
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         Role        @default(ESTUDANTE)
  /// Data em que o usuário consentiu com a Política de Privacidade (LGPD, art. 7º I e art. 11 I)
  consentAt    DateTime    @map("consent_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  entries      MoodEntry[]
  feedback     Feedback?

  @@map("users")
}

/// Avaliação da aplicação respondida pelo usuário (uma por usuário, pode ser atualizada).
/// Ao excluir a conta, a avaliação é mantida de forma anônima (user_id passa a ser nulo).
model Feedback {
  id            String   @id @default(uuid())
  userId        String?  @unique @map("user_id")
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Perfil do participante no momento da resposta
  role          Role
  /// Respostas às 10 afirmações do System Usability Scale (1 = discordo totalmente, 5 = concordo totalmente)
  susAnswers    Int[]    @map("sus_answers")
  /// Pontuação SUS de 0 a 100
  susScore      Float    @map("sus_score")
  /// "Os gráficos e indicadores do painel foram úteis" (1 a 5)
  usefulness    Int
  /// "A aplicação me ajudou a perceber padrões nas minhas emoções" (1 a 5)
  selfAwareness Int      @map("self_awareness")
  /// Quantidade de registros de humor do usuário no momento da resposta
  entriesCount  Int      @map("entries_count")
  liked         String?
  improve       String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("feedbacks")
}

/// Registro diário de humor (um por usuário por dia)
model MoodEntry {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  /// Humor de 1 (muito mal) a 5 (muito bem)
  mood       Int
  /// Energia de 1 (muito baixa) a 5 (muito alta)
  energy     Int
  sleepHours Float?   @map("sleep_hours")
  emotions   String[]
  factors    String[]
  /// Anotação livre, armazenada criptografada (AES-256-GCM)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, date])
  @@map("mood_entries")
}
